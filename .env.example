# Server settings for the report function (api/reports.ts). Set these in Vercel (Project > Settings > Environment Variables), NEVER in the repo.
# Placeholders only. The Supabase address and publishable key are read from the same VITE_SUPABASE_* settings the app build uses.

# Who the report email comes from, e.g.  PHC Reports <reports@your-company-domain.example>  (required; there is no default)
REPORT_FROM=
# Time zone for dates and photo stamps on the PDF (optional; default America/Phoenix)
REPORT_TIMEZONE=America/Phoenix
# Leave empty or "gmail" in production. "fake" exists for tests only and is refused in production.
REPORT_TRANSPORT=gmail
# Gmail API (scope gmail.send only). See docs/ops/gmail-send-setup.md
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
